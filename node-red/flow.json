    {
        "id": "978d21adc312b5f0",
        "type": "function",
        "z": "0b5dbe6d2af4201d",
        "name": "function 1",
        "func": "\nconst valor = Number(msg.payload);\n\nif (!Number.isFinite(valor)) {\n    return null;\n}\n\n// Recebe a temperatura\nif (msg.topic === \"temp_wokwi_dht_pv\") {\n    context.set(\"temperatura\", valor);\n    return null;\n}\n\n// Recebe a umidade\nif (msg.topic === \"hum_wokwi_dht_pv\") {\n\n    const temperatura = context.get(\"temperatura\");\n\n    if (temperatura === undefined) {\n        return null;\n    }\n\n    // Tópico padrão do WEGnology\n    msg.topic = \"wnology/6af4e01e57b889acd44b06ac/state\";\n\n    // Monta o JSON de telemetria\n    msg.payload = JSON.stringify({\n        data: {\n            temperatura: temperatura,\n            umidade: valor\n        }\n    });\n\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
